+# SPDX-License-Identifier: Apache-2.0
+"""LeapQuant per-window recurrent-state quantization for GDN decode (torch prototype).
+
+Port of the LeapQuant GDN contracts (arXiv:2609.38166, NVlabs/kda PR #10):
+the recurrent state is kept as an int8 smoothed residual plus a few fp16
+Compensator Tokens, the last WINDOW rank-1 updates are buffered in bf16, and
+the state is re-quantized once per window by ``flush``.
+
+Storage is in-place: the composite checkpoint lives inside the layer's own
+fp32 ssm_state slot buffer (a slot is 2 MB, the composite layout needs
+~0.9 MB), so the prototype adds no extra device memory. A slot holds either
+the dense fp32 state (immediately after a dense-path write, before resync)
+or the composite format (every other time in LeapQuant mode).
+
+This module is the eager torch path used to validate end-to-end accuracy on
+real weights before the Triton/AscendC kernels replace the hot spots.
+"""
+
+import torch
+
+QMAX = 127.0
+EPS = 1e-12
+WINDOW = 16
+NUM_COMP_TOKENS = 4
+_MGS_PASSES = 2
+_Q0_SEED = 20260930
+
+# byte offsets within one slot buffer (all 128-byte aligned)
+_OFF_CODES = 0
+_OFF_KBUF = 524288  # 32*128*128 int8
+_OFF_UBUF = 655360  # + 32*16*128*2
+_OFF_U = 786432  # + 32*16*128*2
+_OFF_Q = 819200  # + 32*4*128*2
+_OFF_SK = 852992  # + 32*4*128*2
+_OFF_SV = 869376  # + 32*128*4
+_OFF_W = 885760  # + 32*128*4
+_OFF_P = 887808  # + 32*16*4
+_OFF_FILL = 887936  # + 32*4
+_LAYOUT_END = 888068  # + 32*4
+
+
+def _mgs(m: torch.Tensor) -> torch.Tensor:
+    """Modified Gram-Schmidt on the columns of m, projections applied twice."""
+    cols = []
+    for j in range(m.shape[-1]):
+        v = m[..., j]
+        for _ in range(_MGS_PASSES):
+            for c in cols:
+                v = v - c * (c * v).sum(-1, keepdim=True)
+        cols.append(v / v.norm(dim=-1, keepdim=True).clamp_min(1e-30))
+    return torch.stack(cols, -1)
+
+
+def _quantize(S: torch.Tensor, q0: torch.Tensor) -> tuple[torch.Tensor, ...]:
+    """Quantize a dense fp32 state [..., V, K] into a LeapQuant checkpoint."""
+    x = S.transpose(-1, -2)  # [..., K, V]
+    qk = _mgs(x @ q0)  # [..., K, R]
+    qv = _mgs(x.transpose(-1, -2) @ qk)  # [..., V, R]
+    uk = x @ qv  # [..., K, R]
+    u_new = uk.transpose(-1, -2).to(torch.float16)  # [..., R, K]
+    q_new = qv.transpose(-1, -2).to(torch.float16)  # [..., R, V]
+    e = S - torch.einsum("...rv,...rk->...vk", q_new.float(), u_new.float())
+    s_k = e.abs().mean(dim=-2).sqrt().clamp_min(EPS)
+    s_v = (e.abs() / s_k.unsqueeze(-2)).amax(dim=-1).clamp_min(EPS)
+    codes = torch.round(e / (s_k.unsqueeze(-2) * s_v.unsqueeze(-1)) * QMAX)
+    codes = codes.clamp(-QMAX, QMAX).to(torch.int8)
+    return codes, s_k, s_v, u_new, q_new
+
+
+class GDNLeapQuantPools:
+    """In-place composite-state views over the layer's ssm_state buffer.
+
+    ``ssm_state`` is [num_slots, H, V, K] fp32 (possibly a strided view into a
+    unified KV buffer). The first ``_LAYOUT_END`` bytes of each slot's storage
+    hold the LeapQuant layout; the rest is unused.
+    """
+
+    def __init__(self, ssm_state: torch.Tensor):
+        assert ssm_state.dtype == torch.float32, f"expect fp32 state, got {ssm_state.dtype}"
+        self.num_slots, self.num_heads, self.head_v, self.head_k = ssm_state.shape
+        H, V, K = self.num_heads, self.head_v, self.head_k
+        self.slot_stride_bytes = ssm_state.stride(0) * 4
+        assert self.slot_stride_bytes >= _LAYOUT_END, "slot buffer too small for LeapQuant layout"
+        i8 = ssm_state.view(torch.int8)  # [num_slots, H, V, K*4]; last-dim fp32->int8 view
+        slot_bytes = self.num_heads * self.head_v * self.head_k * 4
+        flat = torch.as_strided(i8, (self.num_slots, slot_bytes), (i8.stride(0), 1))
+        self._flat = flat
+
+        def typed(offset: int, dtype: torch.dtype, *tail: int) -> torch.Tensor:
+            n = 1
+            for d in tail:
+                n *= d
+            esize = torch.tensor([], dtype=dtype).element_size()
+            cols = flat[:, offset : offset + n * esize]
+            return cols.view(dtype).view(self.num_slots, *tail)
+
+        self.codes = typed(_OFF_CODES, torch.int8, H, V, K)
+        self.kbuf = typed(_OFF_KBUF, torch.bfloat16, H, WINDOW, K)
+        self.ubuf = typed(_OFF_UBUF, torch.bfloat16, H, WINDOW, V)
+        self.u = typed(_OFF_U, torch.float16, H, NUM_COMP_TOKENS, K)
+        self.q = typed(_OFF_Q, torch.float16, H, NUM_COMP_TOKENS, V)
+        self.s_k = typed(_OFF_SK, torch.float32, H, K)
+        self.s_v = typed(_OFF_SV, torch.float32, H, V)
+        self.w = typed(_OFF_W, torch.float32, H, WINDOW)
+        self.p = typed(_OFF_P, torch.float32, H)
+        self.fill = typed(_OFF_FILL, torch.int32, H)
+        gen = torch.Generator(device="cpu").manual_seed(_Q0_SEED)
+        self.q0 = torch.randn(V, NUM_COMP_TOKENS, dtype=torch.float32, generator=gen).to(ssm_state.device)
+
+    def th_index(self, idx: torch.Tensor) -> tuple[torch.Tensor, torch.Tensor]:
+        T = idx.shape[0]
+        t_idx = idx.view(T, 1).expand(T, self.num_heads)
+        h_idx = torch.arange(self.num_heads, device=idx.device).view(1, -1).expand(T, self.num_heads)
+        return t_idx, h_idx
+
+    def decode_step(
+        self,
+        idx: torch.Tensor,
+        kn: torch.Tensor,
+        qn: torch.Tensor,
+        v: torch.Tensor,
+        g_log: torch.Tensor,
+        beta: torch.Tensor,
+        scale: float,
+    ) -> torch.Tensor:
+        """One decode step over a batch of sequences.
+
+        kn, qn: [T, H, K] l2-normalized bf16 (already expanded to value heads,
+            qn without the K**-0.5 factor); v: [T, H, V] bf16;
+            g_log: [T, H] fp32 log-decay; beta: [T, H] bf16; idx: [T] slot ids.
+        Returns o [T, H, V] bf16 and appends the rank-1 update in place.
+        """
+        t_idx, h_idx = self.th_index(idx)
+        L = WINDOW
+
+        codes = self.codes[t_idx, h_idx].float()
+        s_k = self.s_k[t_idx, h_idx]
+        s_v = self.s_v[t_idx, h_idx]
+        s0 = torch.einsum("bhrv,bhrk->bhvk", self.q[t_idx, h_idx].float(), self.u[t_idx, h_idx].float())
+        s0 = s0 + codes * (s_k / QMAX).unsqueeze(-2) * s_v.unsqueeze(-1)
+
+        p = self.p[t_idx, h_idx]
+        at = torch.exp(g_log.float())
+        pn = p * at
+        f = self.fill[t_idx, h_idx]
+        w = self.w[t_idx, h_idx] * at.unsqueeze(-1)  # dead entries stay 0
+        # dead buffer slots may hold stale bytes that are not finite as bf16;
+        # mask them out so 0 * NaN does not poison the reconstruction
+        j = torch.arange(L, device=idx.device)
+        live = (j.view(1, 1, L) < f.unsqueeze(-1)).unsqueeze(-1)
+        ubuf = torch.where(live, self.ubuf[t_idx, h_idx].float(), torch.zeros((), device=idx.device))
+        kbuf = torch.where(live, self.kbuf[t_idx, h_idx].float(), torch.zeros((), device=idx.device))
+        s = pn.unsqueeze(-1).unsqueeze(-1) * s0 + torch.einsum("bhj,bhjv,bhjk->bhvk", w, ubuf, kbuf)
+
+        beta_f = beta.float()
+        upd = beta_f.unsqueeze(-1) * (v.float() - torch.einsum("bhvk,bhk->bhv", s, kn.float()))
+        qn_s = qn.float() * scale
+        o = torch.einsum("bhvk,bhk->bhv", s, qn_s) + (kn.float() * qn_s).sum(-1, keepdim=True) * upd
+
+        # append the new update at entry f
+        self.kbuf[t_idx, h_idx, f] = kn.to(torch.bfloat16)
+        self.ubuf[t_idx, h_idx, f] = upd.to(torch.bfloat16)
+        j = torch.arange(L, device=idx.device)
+        w_new = torch.where(j.view(1, 1, L) == f.unsqueeze(-1), torch.ones_like(w), w)
+        self.w[t_idx, h_idx] = w_new
+        self.p[t_idx, h_idx] = pn
+        self.fill[t_idx, h_idx] = f + 1
+        return o.to(torch.bfloat16)
+
+    @torch.no_grad()
+    def flush(self, idx: torch.Tensor) -> None:
+        """Re-quantize the slots of idx whose window just ended (fill == L)."""
+        t_idx, h_idx = self.th_index(idx)
+        f = self.fill[t_idx, h_idx]
+        due4 = (f >= WINDOW).unsqueeze(-1).unsqueeze(-1)
+        due3 = (f >= WINDOW).unsqueeze(-1)
+        due2 = f >= WINDOW
+
+        codes = self.codes[t_idx, h_idx].float()
+        s_k = self.s_k[t_idx, h_idx]
+        s_v = self.s_v[t_idx, h_idx]
+        s_old = torch.einsum("bhrv,bhrk->bhvk", self.q[t_idx, h_idx].float(), self.u[t_idx, h_idx].float())
+        s_old = s_old + codes * (s_k / QMAX).unsqueeze(-2) * s_v.unsqueeze(-1)
+        # mask dead buffer slots: stale bytes may be non-finite as bf16
+        j = torch.arange(WINDOW, device=idx.device)
+        live = (j.view(1, 1, WINDOW) < f.unsqueeze(-1)).unsqueeze(-1)
+        ubuf = torch.where(live, self.ubuf[t_idx, h_idx].float(), torch.zeros((), device=idx.device))
+        kbuf = torch.where(live, self.kbuf[t_idx, h_idx].float(), torch.zeros((), device=idx.device))
+        s = self.p[t_idx, h_idx].unsqueeze(-1).unsqueeze(-1) * s_old + torch.einsum(
+            "bhj,bhjv,bhjk->bhvk",
+            self.w[t_idx, h_idx],
+            ubuf,
+            kbuf,
+        )
+
+        c, sk, sv, u_new, q_new = _quantize(s, self.q0)
+        self.codes[t_idx, h_idx] = torch.where(due4, c, self.codes[t_idx, h_idx])
+        self.s_k[t_idx, h_idx] = torch.where(due3, sk, self.s_k[t_idx, h_idx])
+        self.s_v[t_idx, h_idx] = torch.where(due3, sv, self.s_v[t_idx, h_idx])
+        self.u[t_idx, h_idx] = torch.where(due4, u_new, self.u[t_idx, h_idx])
+        self.q[t_idx, h_idx] = torch.where(due4, q_new, self.q[t_idx, h_idx])
+        self.w[t_idx, h_idx] = torch.where(due3, torch.zeros_like(self.w[t_idx, h_idx]), self.w[t_idx, h_idx])
+        self.p[t_idx, h_idx] = torch.where(due2, torch.ones_like(self.p[t_idx, h_idx]), self.p[t_idx, h_idx])
+        self.fill[t_idx, h_idx] = torch.where(due2, torch.zeros_like(f), f)
+
+    @torch.no_grad()
+    def init_from_dense(self, ssm_state: torch.Tensor, idx: torch.Tensor) -> None:
+        """Quantize the dense fp32 states of slots idx into composite checkpoints.
+
+        Must be called right after a dense-path write to those slots; reads the
+        dense values via a gather first, so in-place aliasing is safe.
+        """
+        t_idx, h_idx = self.th_index(idx)
+        dense = ssm_state[idx].clone().float()
+        c, sk, sv, u_new, q_new = _quantize(dense, self.q0)
+        self.codes[t_idx, h_idx] = c
+        self.s_k[t_idx, h_idx] = sk
+        self.s_v[t_idx, h_idx] = sv
+        self.u[t_idx, h_idx] = u_new
+        self.q[t_idx, h_idx] = q_new
+        self.w[t_idx, h_idx] = 0.0
+        self.p[t_idx, h_idx] = 1.0
+        self.fill[t_idx, h_idx] = 0
+        # the stale dense bytes behind the buffer views are not finite as bf16
+        self.kbuf[t_idx, h_idx] = 0.0
+        self.ubuf[t_idx, h_idx] = 0.0
+
+    def decode_state(self, idx: torch.Tensor) -> torch.Tensor:
+        """Dense fp32 reconstruction of the checkpoint part (window buffer excluded)."""
+        t_idx, h_idx = self.th_index(idx)
+        s = torch.einsum("bhrv,bhrk->bhvk", self.q[t_idx, h_idx].float(), self.u[t_idx, h_idx].float())
+        return s + self.codes[t_idx, h_idx].float() * (self.s_k[t_idx, h_idx] / QMAX).unsqueeze(
+            -2
+        ) * self.s_v[t_idx, h_idx].unsqueeze(-1)
diff --git a/vllm_ascend/ops/gdn_lq_flush_ascendc.py b/vllm_ascend/ops/gdn_lq_flush_ascendc.py
new file mode 100644
index 0000000..6836ffa
--- /dev/null
+++ b/vllm_ascend/ops/gdn_lq_flush_ascendc.py
@@ -0,0 +1,168 @@
+# SPDX-License-Identifier: Apache-2.0
+"""AscendC LeapQuant GDN window flush (A3) — ctypes binding wrapper.
+
+Calls the custom opp op ``GdnLqFlush`` (gdn_lq_flush) in libcust_opapi.so.
+The op updates the LeapQuant composite checkpoint in place inside the fp32
+ssm_state slot buffer; the caller passes the same tensor as output.
+
+q0 is expected pre-transposed as [R, V] fp32 (row r = torch q0[:, r]).
+"""
+
+import ctypes
+import glob
+import os
+
+import torch
+
+_B = None
+_AVAILABLE = None
+_CACHE = {}
+_CACHE_CAP = 256  # keyed by data_ptrs; addresses are stable in decode loops
+_WS_BUF = None  # one shared workspace: the op's kernel takes no workspace
+# argument, and aclnn executions on the same stream are serialized, so a
+# single buffer sized to the max requested workspace serves all executors
+# (the autogen wrapper derives ~state-size workspace per call site).
+
+
+def _binding():
+    global _B, _AVAILABLE
+    if _AVAILABLE is False:
+        return None
+    if _B is None:
+        cands = (glob.glob("/tmp/probe_opp_v*/vendors/custom_transformer/"
+                           "op_api/lib/libcust_opapi.so")
+                 + glob.glob("/usr/local/Ascend/opp/vendors/*/op_api/lib/"
+                             "libcust_opapi.so", recursive=True)
+                 + glob.glob("/mnt/workspace/vllm-ascend/vllm_ascend/"
+                             "_cann_ops_custom/**/op_api/lib/libcust_opapi.so",
+                             recursive=True))
+        if not cands:
+            _AVAILABLE = False
+            return None
+        try:
+            lib = ctypes.CDLL(cands[0])
+        except OSError:
+            _AVAILABLE = False
+            return None
+        import torch_npu  # noqa: F401
+
+        from fla_npu.ops.ascendc import _runtime as rt
+
+        _B = (rt, rt.runtime(), lib)
+        lib.aclnnGdnLqFlushGetWorkspaceSize.restype = ctypes.c_int
+        lib.aclnnGdnLqFlush.argtypes = [
+            ctypes.c_void_p, ctypes.c_uint64, ctypes.c_void_p, ctypes.c_void_p
+        ]
+        lib.aclnnGdnLqFlush.restype = ctypes.c_int
+    return _B
+
+
+def gdn_lq_flush_ascendc(state, idx, q0_rv, num_heads) -> bool:
+    """Flush due slots of the decode batch idx in place.
+
+    state: fp32 [SLOTS, H, V, K] ssm_state buffer (strided view is fine, the
+        slot stride in bytes is taken from state.stride(0) * 4).
+    idx: int64 [T] slot ids.
+    q0_rv: fp32 [R, V] subspace seed, rows = torch q0 columns.
+    Returns False when the custom op is unavailable (caller falls back).
+    """
+    try:
+        if torch.npu.is_current_stream_capturing():
+            return False
+    except Exception:
+        return False
+    bnd = _binding()
+    if bnd is None:
+        return False
+    rt, runtime, lib = bnd
+    dev = state.device
+    idx = idx.to(device=dev, dtype=torch.int64)
+    if not idx.is_contiguous():
+        idx = idx.contiguous()
+    if not q0_rv.is_contiguous():
+        q0_rv = q0_rv.contiguous()
+    slot_stride_bytes = state.stride(0) * state.element_size()
+    stream = int(torch.npu.current_stream().npu_stream)
+    key = (int(state.data_ptr()), int(idx.data_ptr()), int(q0_rv.data_ptr()),
+           int(state.stride(0)), int(idx.shape[0]), int(num_heads))
+    hit = _CACHE.get(key)
+    global _WS_BUF
+    if hit is not None:
+        executor = hit[0]
+        ret = lib.aclnnGdnLqFlush(
+            ctypes.c_void_p(int(_WS_BUF.data_ptr())),
+            ctypes.c_uint64(_WS_BUF.numel()),
+            executor, ctypes.c_void_p(stream))
+        return ret == 0
+    try:
+        ctx = rt._CallContext(runtime, dev)
+    except Exception:
+        return False
+    try:
+        args = [
+            ctx.tensor(state, "state"),
+            ctx.tensor(idx, "idx"),
+            ctx.tensor(q0_rv, "q0"),
+            ctypes.c_int64(int(num_heads)),
+            ctypes.c_int64(int(slot_stride_bytes)),
+            ctx.tensor(state, "out"),  # in-place: aliased output
+        ]
+        ws_size = ctypes.c_uint64(0)
+        executor = ctypes.c_void_p()
+        ret = lib.aclnnGdnLqFlushGetWorkspaceSize(
+            *args, ctypes.byref(ws_size), ctypes.byref(executor))
+        assert ret == 0, f"get_ws ret={ret} ws={ws_size.value}"
+        if os.getenv("VLLM_ASCEND_GDN_LQ_DEBUG"):
+            print(
+                f"[gdn-lq-flush] new executor key_state={int(state.data_ptr()) & 0xffff} "
+                f"T={idx.shape[0]} ws={ws_size.value} "
+                f"allocated={torch.npu.memory_allocated() / 2**30:.2f}GiB",
+                flush=True,
+            )
+        need = int(ws_size.value) if ws_size.value else 1
+        if _WS_BUF is None or _WS_BUF.numel() < need:
+            _WS_BUF = torch.empty(need, dtype=torch.uint8, device=dev)
+        ret = lib.aclnnGdnLqFlush(
+            ctypes.c_void_p(int(_WS_BUF.data_ptr())),
+            ctypes.c_uint64(need), executor,
+            ctypes.c_void_p(stream))
+        assert ret == 0, f"launch ret={ret}"
+        if len(_CACHE) >= _CACHE_CAP:
+            _CACHE.clear()
+        # keep the tensors alive: the executor bakes their addresses
+        _CACHE[key] = (executor, state, idx, q0_rv)
+        return True
+    except Exception as e:
+        import sys
+        print(f"[gdn-lq-flush] slow-path exception: {type(e).__name__}: {e!r}",
+              file=sys.stderr, flush=True)
+        return False
+    finally:
+        ctx.destroy()
+
+
+def flush_pools_ascendc(pools, idx) -> bool:
+    """Drop-in replacement for GDNLeapQuantPools.flush via the AscendC op."""
+    return gdn_lq_flush_ascendc(_state_tensor(pools), idx,
+                                _q0_rows(pools), pools.num_heads)
+
+
+_Q0_ROWS = {}
+
+
+def _q0_rows(pools):
+    """Persistent [R, V] transpose of pools.q0 (stable executor cache key)."""
+    key = (pools.q0.device, int(pools.q0.data_ptr()), tuple(pools.q0.shape))
+    buf = _Q0_ROWS.get(key)
+    if buf is None:
+        buf = pools.q0.t().contiguous()
+        _Q0_ROWS.clear()  # bounded: one entry per pools instance
+        _Q0_ROWS[key] = buf
+    return buf
+
+
+def _state_tensor(pools):
+    # pools keeps the strided int8 view over the layer ssm_state; recover the
+    # fp32 view with the same slot stride so the kernel sees identical layout
+    flat = pools._flat  # [num_slots, slot_bytes] int8
+    return flat.view(torch.float32)
diff --git a/vllm_ascend/ops/triton/gdn_leapquant_flush.py b/vllm_ascend/ops/triton/gdn_leapquant_flush.py
new file mode 100644
index 0000000..72960c9
--- /dev/null
+++ b/vllm_ascend/ops/triton/gdn_leapquant_flush.py
@@ -0,0 +1,307 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Triton-Ascend window-flush kernel for LeapQuant-quantized GDN state.
+
+One program per (sequence, head); programs whose window has not ended
+(fill < L) exit immediately. Due programs rebuild the fp32 state from the
+composite checkpoint plus the buffered updates, fit R Compensator Tokens with
+one round of subspace iteration (modified Gram-Schmidt, projections applied
+twice), smooth and quantize the residual to int8, and reset the window.
+
+The state is processed in V-chunks of VH rows so the Unified Buffer footprint
+stays small: five passes (subspace start, orthogonal factor, update factor,
+smoothing scales, quantization) rebuild the chunk on each pass.
+"""
+
+import torch
+from vllm.triton_utils import tl, triton
+
+QMAX: tl.constexpr = 127.0
+EPS: tl.constexpr = 1e-12
+
+
+@triton.jit
+def _rebuild_chunk(
+    codes_ptr,
+    kbuf_ptr,
+    ubuf_ptr,
+    u_ptr,
+    q_ptr,
+    sk_ptr,
+    sv_ptr,
+    w_ptr,
+    p_ptr,
+    slot,
+    h,
+    f,
+    rv_h,
+    cs0,
+    kbs0,
+    ubs0,
+    us0,
+    qs0,
+    sks0,
+    svs0,
+    ws0,
+    ps0,
+    V: tl.constexpr,
+    K: tl.constexpr,
+    L: tl.constexpr,
+    R: tl.constexpr,
+):
+    rk = tl.arange(0, K)
+    sv_h = tl.load(sv_ptr + slot * svs0 + h * V + rv_h)
+    sk_old = tl.load(sk_ptr + slot * sks0 + h * K + rk)
+    codes = tl.load(codes_ptr + slot * cs0 + h * V * K + rv_h[:, None] * K + rk[None, :]).to(tl.float32)
+    S = codes * (sk_old[None, :] / QMAX) * sv_h[:, None]
+    for r in tl.static_range(R):
+        qr = tl.load(q_ptr + slot * qs0 + (h * R + r) * V + rv_h).to(tl.float32)
+        ur = tl.load(u_ptr + slot * us0 + (h * R + r) * K + rk).to(tl.float32)
+        S += qr[:, None] * ur[None, :]
+    p = tl.load(p_ptr + slot * ps0 + h)
+    S = p * S
+    for j in tl.static_range(L):
+        ub = tl.load(ubuf_ptr + slot * ubs0 + (h * L + j) * V + rv_h, mask=j < f, other=0.0).to(tl.float32)
+        kb = tl.load(kbuf_ptr + slot * kbs0 + (h * L + j) * K + rk, mask=j < f, other=0.0).to(tl.float32)
+        wj = tl.load(w_ptr + slot * ws0 + h * L + j, mask=j < f, other=0.0)
+        S += wj * ub[:, None] * kb[None, :]
+    return S
+
+
+@triton.jit
+def _gdn_lq_flush_kernel(
+    codes_ptr,
+    kbuf_ptr,
+    ubuf_ptr,
+    u_ptr,
+    q_ptr,
+    sk_ptr,
+    sv_ptr,
+    w_ptr,
+    p_ptr,
+    fill_ptr,
+    q0_ptr,
+    idx_ptr,
+    cs0,
+    kbs0,
+    ubs0,
+    us0,
+    qs0,
+    sks0,
+    svs0,
+    ws0,
+    ps0,
+    fs0,
+    H: tl.constexpr,
+    V: tl.constexpr,
+    K: tl.constexpr,
+    L: tl.constexpr,
+    R: tl.constexpr,
+    VH: tl.constexpr,
+):
+    pid = tl.program_id(0)
+    b = pid // H
+    h = pid % H
+    slot = tl.load(idx_ptr + b)
+
+    f = tl.load(fill_ptr + slot * fs0 + h)
+    due = f >= L
+    f = tl.where(due, f, L)  # clamp: non-due programs run masked, stores are guarded
+
+    NH: tl.constexpr = V // VH
+    rv = tl.arange(0, V)
+    rk = tl.arange(0, K)
+    rl = tl.arange(0, L)
+
+    # pass 1: m1_r = S^T q0_r, accumulated over V-chunks; then MGS -> qk_r
+    m1_0 = tl.zeros((K,), dtype=tl.float32)
+    m1_1 = tl.zeros((K,), dtype=tl.float32)
+    m1_2 = tl.zeros((K,), dtype=tl.float32)
+    m1_3 = tl.zeros((K,), dtype=tl.float32)
+    for vh in range(NH):
+        rv_h = vh * VH + tl.arange(0, VH)
+        S_h = _rebuild_chunk(codes_ptr, kbuf_ptr, ubuf_ptr, u_ptr, q_ptr, sk_ptr, sv_ptr,
+                             w_ptr, p_ptr, slot, h, f, rv_h, cs0, kbs0, ubs0, us0, qs0,
+                             sks0, svs0, ws0, ps0, V, K, L, R)
+        q0_0 = tl.load(q0_ptr + 0 * V + rv_h)
+        q0_1 = tl.load(q0_ptr + 1 * V + rv_h)
+        q0_2 = tl.load(q0_ptr + 2 * V + rv_h)
+        q0_3 = tl.load(q0_ptr + 3 * V + rv_h)
+        m1_0 += tl.sum(S_h * q0_0[:, None], axis=0)
+        m1_1 += tl.sum(S_h * q0_1[:, None], axis=0)
+        m1_2 += tl.sum(S_h * q0_2[:, None], axis=0)
+        m1_3 += tl.sum(S_h * q0_3[:, None], axis=0)
+    # MGS (twice is enough), normalizing each column before the next uses it
+    n0 = tl.maximum(tl.sqrt(tl.sum(m1_0 * m1_0, axis=0)), 1e-30)
+    qk_0 = m1_0 / n0
+    qk_1 = m1_1 - qk_0 * tl.sum(qk_0 * m1_1, axis=0)
+    qk_1 = qk_1 - qk_0 * tl.sum(qk_0 * qk_1, axis=0)
+    qk_1 = qk_1 / tl.maximum(tl.sqrt(tl.sum(qk_1 * qk_1, axis=0)), 1e-30)
+    qk_2 = m1_2 - qk_0 * tl.sum(qk_0 * m1_2, axis=0)
+    qk_2 = qk_2 - qk_1 * tl.sum(qk_1 * qk_2, axis=0)
+    qk_2 = qk_2 - qk_0 * tl.sum(qk_0 * qk_2, axis=0)
+    qk_2 = qk_2 - qk_1 * tl.sum(qk_1 * qk_2, axis=0)
+    qk_2 = qk_2 / tl.maximum(tl.sqrt(tl.sum(qk_2 * qk_2, axis=0)), 1e-30)
+    qk_3 = m1_3 - qk_0 * tl.sum(qk_0 * m1_3, axis=0)
+    qk_3 = qk_3 - qk_1 * tl.sum(qk_1 * qk_3, axis=0)
+    qk_3 = qk_3 - qk_2 * tl.sum(qk_2 * qk_3, axis=0)
+    qk_3 = qk_3 - qk_0 * tl.sum(qk_0 * qk_3, axis=0)
+    qk_3 = qk_3 - qk_1 * tl.sum(qk_1 * qk_3, axis=0)
+    qk_3 = qk_3 - qk_2 * tl.sum(qk_2 * qk_3, axis=0)
+    qk_3 = qk_3 / tl.maximum(tl.sqrt(tl.sum(qk_3 * qk_3, axis=0)), 1e-30)
+
+    # pass 2: qv_r = S qk_r over V-chunks; then MGS -> qv_r
+    qv_0 = tl.zeros((V,), dtype=tl.float32)
+    qv_1 = tl.zeros((V,), dtype=tl.float32)
+    qv_2 = tl.zeros((V,), dtype=tl.float32)
+    qv_3 = tl.zeros((V,), dtype=tl.float32)
+    for vh in range(NH):
+        rv_h = vh * VH + tl.arange(0, VH)
+        S_h = _rebuild_chunk(codes_ptr, kbuf_ptr, ubuf_ptr, u_ptr, q_ptr, sk_ptr, sv_ptr,
+                             w_ptr, p_ptr, slot, h, f, rv_h, cs0, kbs0, ubs0, us0, qs0,
+                             sks0, svs0, ws0, ps0, V, K, L, R)
+        OH = rv[:, None] == rv_h[None, :]
+        qv_0 += tl.sum(tl.where(OH, tl.sum(S_h * qk_0[None, :], axis=1)[None, :], 0.0), axis=1)
+        qv_1 += tl.sum(tl.where(OH, tl.sum(S_h * qk_1[None, :], axis=1)[None, :], 0.0), axis=1)
+        qv_2 += tl.sum(tl.where(OH, tl.sum(S_h * qk_2[None, :], axis=1)[None, :], 0.0), axis=1)
+        qv_3 += tl.sum(tl.where(OH, tl.sum(S_h * qk_3[None, :], axis=1)[None, :], 0.0), axis=1)
+    n0 = tl.maximum(tl.sqrt(tl.sum(qv_0 * qv_0, axis=0)), 1e-30)
+    qv_0 = qv_0 / n0
+    qv_1 = qv_1 - qv_0 * tl.sum(qv_0 * qv_1, axis=0)
+    qv_1 = qv_1 - qv_0 * tl.sum(qv_0 * qv_1, axis=0)
+    qv_1 = qv_1 / tl.maximum(tl.sqrt(tl.sum(qv_1 * qv_1, axis=0)), 1e-30)
+    qv_2 = qv_2 - qv_0 * tl.sum(qv_0 * qv_2, axis=0)
+    qv_2 = qv_2 - qv_1 * tl.sum(qv_1 * qv_2, axis=0)
+    qv_2 = qv_2 - qv_0 * tl.sum(qv_0 * qv_2, axis=0)
+    qv_2 = qv_2 - qv_1 * tl.sum(qv_1 * qv_2, axis=0)
+    qv_2 = qv_2 / tl.maximum(tl.sqrt(tl.sum(qv_2 * qv_2, axis=0)), 1e-30)
+    qv_3 = qv_3 - qv_0 * tl.sum(qv_0 * qv_3, axis=0)
+    qv_3 = qv_3 - qv_1 * tl.sum(qv_1 * qv_3, axis=0)
+    qv_3 = qv_3 - qv_2 * tl.sum(qv_2 * qv_3, axis=0)
+    qv_3 = qv_3 - qv_0 * tl.sum(qv_0 * qv_3, axis=0)
+    qv_3 = qv_3 - qv_1 * tl.sum(qv_1 * qv_3, axis=0)
+    qv_3 = qv_3 - qv_2 * tl.sum(qv_2 * qv_3, axis=0)
+    qv_3 = qv_3 / tl.maximum(tl.sqrt(tl.sum(qv_3 * qv_3, axis=0)), 1e-30)
+
+    # pass 3: uk_r = S^T qv_r over V-chunks
+    uk_0 = tl.zeros((K,), dtype=tl.float32)
+    uk_1 = tl.zeros((K,), dtype=tl.float32)
+    uk_2 = tl.zeros((K,), dtype=tl.float32)
+    uk_3 = tl.zeros((K,), dtype=tl.float32)
+    for vh in range(NH):
+        rv_h = vh * VH + tl.arange(0, VH)
+        S_h = _rebuild_chunk(codes_ptr, kbuf_ptr, ubuf_ptr, u_ptr, q_ptr, sk_ptr, sv_ptr,
+                             w_ptr, p_ptr, slot, h, f, rv_h, cs0, kbs0, ubs0, us0, qs0,
+                             sks0, svs0, ws0, ps0, V, K, L, R)
+        OH = rv[:, None] == rv_h[None, :]
+        qv_0h = tl.sum(tl.where(OH, qv_0[:, None], 0.0), axis=0)
+        qv_1h = tl.sum(tl.where(OH, qv_1[:, None], 0.0), axis=0)
+        qv_2h = tl.sum(tl.where(OH, qv_2[:, None], 0.0), axis=0)
+        qv_3h = tl.sum(tl.where(OH, qv_3[:, None], 0.0), axis=0)
+        uk_0 += tl.sum(S_h * qv_0h[:, None], axis=0)
+        uk_1 += tl.sum(S_h * qv_1h[:, None], axis=0)
+        uk_2 += tl.sum(S_h * qv_2h[:, None], axis=0)
+        uk_3 += tl.sum(S_h * qv_3h[:, None], axis=0)
+
+    # pass 4a: column absolute sums across all V-chunks (sk needs the full mean)
+    sum_abs = tl.zeros((K,), dtype=tl.float32)
+    for vh in range(NH):
+        rv_h = vh * VH + tl.arange(0, VH)
+        S_h = _rebuild_chunk(codes_ptr, kbuf_ptr, ubuf_ptr, u_ptr, q_ptr, sk_ptr, sv_ptr,
+                             w_ptr, p_ptr, slot, h, f, rv_h, cs0, kbs0, ubs0, us0, qs0,
+                             sks0, svs0, ws0, ps0, V, K, L, R)
+        OH = rv[:, None] == rv_h[None, :]
+        qv_0h = tl.sum(tl.where(OH, qv_0[:, None], 0.0), axis=0)
+        qv_1h = tl.sum(tl.where(OH, qv_1[:, None], 0.0), axis=0)
+        qv_2h = tl.sum(tl.where(OH, qv_2[:, None], 0.0), axis=0)
+        qv_3h = tl.sum(tl.where(OH, qv_3[:, None], 0.0), axis=0)
+        E = S_h - qv_0h[:, None] * uk_0[None, :] - qv_1h[:, None] * uk_1[None, :] - qv_2h[:, None] * uk_2[None, :] - qv_3h[:, None] * uk_3[None, :]
+        sum_abs += tl.sum(tl.abs(E), axis=0)
+    sk = tl.maximum(tl.sqrt(sum_abs / V), EPS)
+    tl.store(sk_ptr + slot * sks0 + h * K + rk, sk, mask=due & (rk >= 0))
+
+    # pass 4b: row scales (max over k of the smoothed residual) per chunk
+    sv_new = tl.zeros((V,), dtype=tl.float32)
+    for vh in range(NH):
+        rv_h = vh * VH + tl.arange(0, VH)
+        S_h = _rebuild_chunk(codes_ptr, kbuf_ptr, ubuf_ptr, u_ptr, q_ptr, sk_ptr, sv_ptr,
+                             w_ptr, p_ptr, slot, h, f, rv_h, cs0, kbs0, ubs0, us0, qs0,
+                             sks0, svs0, ws0, ps0, V, K, L, R)
+        OH = rv[:, None] == rv_h[None, :]
+        qv_0h = tl.sum(tl.where(OH, qv_0[:, None], 0.0), axis=0)
+        qv_1h = tl.sum(tl.where(OH, qv_1[:, None], 0.0), axis=0)
+        qv_2h = tl.sum(tl.where(OH, qv_2[:, None], 0.0), axis=0)
+        qv_3h = tl.sum(tl.where(OH, qv_3[:, None], 0.0), axis=0)
+        E = S_h - qv_0h[:, None] * uk_0[None, :] - qv_1h[:, None] * uk_1[None, :] - qv_2h[:, None] * uk_2[None, :] - qv_3h[:, None] * uk_3[None, :]
+        sv_h = tl.max(tl.abs(E) / sk[None, :], axis=1)
+        sv_new = tl.maximum(sv_new, tl.sum(tl.where(OH, sv_h[None, :], 0.0), axis=1))
+    sv_new = tl.maximum(sv_new, EPS)
+
+    # pass 5: quantize the residual per chunk
+    for vh in range(NH):
+        rv_h = vh * VH + tl.arange(0, VH)
+        S_h = _rebuild_chunk(codes_ptr, kbuf_ptr, ubuf_ptr, u_ptr, q_ptr, sk_ptr, sv_ptr,
+                             w_ptr, p_ptr, slot, h, f, rv_h, cs0, kbs0, ubs0, us0, qs0,
+                             sks0, svs0, ws0, ps0, V, K, L, R)
+        OH = rv[:, None] == rv_h[None, :]
+        qv_0h = tl.sum(tl.where(OH, qv_0[:, None], 0.0), axis=0)
+        qv_1h = tl.sum(tl.where(OH, qv_1[:, None], 0.0), axis=0)
+        qv_2h = tl.sum(tl.where(OH, qv_2[:, None], 0.0), axis=0)
+        qv_3h = tl.sum(tl.where(OH, qv_3[:, None], 0.0), axis=0)
+        E = S_h - qv_0h[:, None] * uk_0[None, :] - qv_1h[:, None] * uk_1[None, :] - qv_2h[:, None] * uk_2[None, :] - qv_3h[:, None] * uk_3[None, :]
+        sv_h = tl.sum(tl.where(OH, sv_new[:, None], 0.0), axis=0)
+        scaled = E / (sk[None, :] * sv_h[:, None]) * QMAX
+        qcodes = tl.where(scaled >= 0, tl.floor(scaled + 0.5), tl.ceil(scaled - 0.5))
+        qcodes = tl.minimum(tl.maximum(qcodes, -QMAX), QMAX)
+        tl.store(codes_ptr + slot * cs0 + h * V * K + rv_h[:, None] * K + rk[None, :], qcodes.to(tl.int8), mask=due & (rv_h[:, None] >= 0))
+
+    tl.store(sv_ptr + slot * svs0 + h * V + rv, sv_new, mask=due & (rv >= 0))
+    tl.store(u_ptr + slot * us0 + (h * R + 0) * K + rk, uk_0.to(tl.float16), mask=due & (rk >= 0))
+    tl.store(u_ptr + slot * us0 + (h * R + 1) * K + rk, uk_1.to(tl.float16), mask=due & (rk >= 0))
+    tl.store(u_ptr + slot * us0 + (h * R + 2) * K + rk, uk_2.to(tl.float16), mask=due & (rk >= 0))
+    tl.store(u_ptr + slot * us0 + (h * R + 3) * K + rk, uk_3.to(tl.float16), mask=due & (rk >= 0))
+    tl.store(q_ptr + slot * qs0 + (h * R + 0) * V + rv, qv_0.to(tl.float16), mask=due & (rv >= 0))
+    tl.store(q_ptr + slot * qs0 + (h * R + 1) * V + rv, qv_1.to(tl.float16), mask=due & (rv >= 0))
+    tl.store(q_ptr + slot * qs0 + (h * R + 2) * V + rv, qv_2.to(tl.float16), mask=due & (rv >= 0))
+    tl.store(q_ptr + slot * qs0 + (h * R + 3) * V + rv, qv_3.to(tl.float16), mask=due & (rv >= 0))
+
+    zero_w = tl.zeros((L,), dtype=tl.float32)
+    tl.store(w_ptr + slot * ws0 + h * L + rl, zero_w, mask=due & (rl >= 0))
+    tl.store(p_ptr + slot * ps0 + h, 1.0, mask=due)
+    tl.store(fill_ptr + slot * fs0 + h, 0, mask=due)
+
+
+def gdn_leapquant_flush(pools, idx):
+    """Flush due slots (fill == L) of the decode batch idx in place."""
+    T = idx.shape[0]
+    H = pools.num_heads
+    grid = (T * H,)
+    _gdn_lq_flush_kernel[grid](
+        pools.codes,
+        pools.kbuf,
+        pools.ubuf,
+        pools.u,
+        pools.q,
+        pools.s_k,
+        pools.s_v,
+        pools.w,
+        pools.p,
+        pools.fill,
+        pools.q0,
+        idx,
+        pools.codes.stride(0),
+        pools.kbuf.stride(0),
+        pools.ubuf.stride(0),
+        pools.u.stride(0),
+        pools.q.stride(0),
+        pools.s_k.stride(0),
+        pools.s_v.stride(0),
+        pools.w.stride(0),
+        pools.p.stride(0),
+        pools.fill.stride(0),
+        H=H,
+        V=pools.head_v,
+        K=pools.head_k,
+        L=pools.kbuf.shape[2],
+        R=pools.u.shape[2],
+        VH=32,
+    )
